{
  "openapi": "3.0.0",
  "info": {
    "title": "Logistics API",
    "description": "API para el sistema de logística de envíos",
    "version": "1.0.0",
    "contact": {
      "email": "soporte@logistics.com"
    }
  },
  "servers": [
    {
      "url": "http://localhost:3000/api/v1",
      "description": "Servidor de desarrollo"
    }
  ],
  "tags": [
    {
      "name": "auth",
      "description": "Operaciones de autenticación"
    },
    {
      "name": "envios",
      "description": "Operaciones relacionadas con envíos"
    }
  ],
  "paths": {
    "/auth/register": {
      "post": {
        "tags": ["auth"],
        "summary": "Registrar un nuevo usuario",
        "description": "Crea una nueva cuenta de usuario en el sistema",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["nombre", "cedula", "telefono", "email", "password"],
                "properties": {
                  "nombre": {
                    "type": "string",
                    "example": "Juan Pérez"
                  },
                  "cedula": {
                    "type": "string",
                    "example": "1234567890"
                  },
                  "telefono": {
                    "type": "string",
                    "example": "3001234567"
                  },
                  "email": {
                    "type": "string",
                    "format": "email",
                    "example": "juan@example.com"
                  },
                  "password": {
                    "type": "string",
                    "format": "password",
                    "example": "password123"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Usuario registrado correctamente",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string",
                      "example": "success"
                    },
                    "data": {
                      "type": "object",
                      "properties": {
                        "id": {
                          "type": "integer",
                          "example": 1
                        },
                        "nombre": {
                          "type": "string",
                          "example": "Juan Pérez"
                        },
                        "email": {
                          "type": "string",
                          "example": "juan@example.com"
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Datos inválidos",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string",
                      "example": "error"
                    },
                    "message": {
                      "type": "string",
                      "example": "Todos los campos son obligatorios"
                    }
                  }
                }
              }
            }
          },
          "409": {
            "description": "Conflicto - Usuario ya existe",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string",
                      "example": "error"
                    },
                    "message": {
                      "type": "string",
                      "example": "El email ya está registrado"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/auth/login": {
      "post": {
        "tags": ["auth"],
        "summary": "Iniciar sesión",
        "description": "Autenticar un usuario en el sistema",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["email", "password"],
                "properties": {
                  "email": {
                    "type": "string",
                    "format": "email",
                    "example": "juan@example.com"
                  },
                  "password": {
                    "type": "string",
                    "format": "password",
                    "example": "password123"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Inicio de sesión exitoso",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string",
                      "example": "success"
                    },
                    "data": {
                      "type": "object",
                      "properties": {
                        "token": {
                          "type": "string",
                          "example": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
                        },
                        "user": {
                          "type": "object",
                          "properties": {
                            "id": {
                              "type": "integer",
                              "example": 1
                            },
                            "nombre": {
                              "type": "string",
                              "example": "Juan Pérez"
                            },
                            "email": {
                              "type": "string",
                              "example": "juan@example.com"
                            },
                            "role": {
                              "type": "string",
                              "example": "usuario"
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Datos inválidos",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string",
                      "example": "error"
                    },
                    "message": {
                      "type": "string",
                      "example": "Debe proporcionar email y contraseña"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Autenticación fallida",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string",
                      "example": "error"
                    },
                    "message": {
                      "type": "string",
                      "example": "Credenciales inválidas"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/envios": {
      "post": {
        "tags": ["envios"],
        "summary": "Crear una nueva orden de envío",
        "description": "Crea una nueva orden de envío con información del paquete y dirección de destino",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["paquete", "direccion"],
                "properties": {
                  "paquete": {
                    "type": "object",
                    "required": ["tipo_envio", "peso", "largo", "ancho", "alto", "tipo_producto"],
                    "properties": {
                      "tipo_envio": {
                        "type": "string",
                        "enum": ["mensajeria", "paqueteria"],
                        "example": "paqueteria"
                      },
                      "peso": {
                        "type": "number",
                        "format": "float",
                        "example": 5.2
                      },
                      "largo": {
                        "type": "number",
                        "format": "float",
                        "example": 30
                      },
                      "ancho": {
                        "type": "number",
                        "format": "float",
                        "example": 20
                      },
                      "alto": {
                        "type": "number",
                        "format": "float",
                        "example": 15
                      },
                      "tipo_producto": {
                        "type": "string",
                        "example": "Electrónica"
                      }
                    }
                  },
                  "direccion": {
                    "type": "object",
                    "required": ["calle", "ciudad"],
                    "properties": {
                      "calle": {
                        "type": "string",
                        "example": "Calle 123 #45-67"
                      },
                      "ciudad": {
                        "type": "string",
                        "example": "Bogotá"
                      },
                      "departamento": {
                        "type": "string",
                        "example": "Cundinamarca"
                      },
                      "codigo_postal": {
                        "type": "string",
                        "example": "110111"
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Orden de envío creada correctamente",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string",
                      "example": "success"
                    },
                    "data": {
                      "type": "object",
                      "properties": {
                        "id": {
                          "type": "integer",
                          "example": 1
                        },
                        "estado_actual": {
                          "type": "string",
                          "example": "en_espera"
                        },
                        "guia": {
                          "type": "string",
                          "example": "COO8JX3K2WQ"
                        },
                        "paquete": {
                          "type": "object",
                          "properties": {
                            "id": {
                              "type": "integer",
                              "example": 1
                            },
                            "tipo_envio": {
                              "type": "string",
                              "example": "paqueteria"
                            },
                            "peso": {
                              "type": "number",
                              "example": 5.2
                            },
                            "dimensiones": {
                              "type": "object",
                              "properties": {
                                "largo": {
                                  "type": "number",
                                  "example": 30
                                },
                                "ancho": {
                                  "type": "number",
                                  "example": 20
                                },
                                "alto": {
                                  "type": "number",
                                  "example": 15
                                }
                              }
                            },
                            "tipo_producto": {
                              "type": "string",
                              "example": "Electrónica"
                            }
                          }
                        },
                        "direccion": {
                          "type": "object",
                          "properties": {
                            "id": {
                              "type": "integer",
                              "example": 1
                            },
                            "calle": {
                              "type": "string",
                              "example": "Calle 123 #45-67"
                            },
                            "ciudad": {
                              "type": "string",
                              "example": "Bogotá"
                            },
                            "departamento": {
                              "type": "string",
                              "example": "Cundinamarca"
                            },
                            "codigo_postal": {
                              "type": "string",
                              "example": "110111"
                            }
                          }
                        },
                        "fecha_registro": {
                          "type": "string",
                          "format": "date-time",
                          "example": "2023-04-16T10:30:00Z"
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Datos inválidos o dirección inválida",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string",
                      "example": "error"
                    },
                    "message": {
                      "type": "string",
                      "example": "El peso debe ser mayor a 0"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "No autenticado",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string",
                      "example": "error"
                    },
                    "message": {
                      "type": "string",
                      "example": "Debe estar autenticado para crear órdenes de envío"
                    }
                  }
                }
              }
            }
          },
          "500": {
            "description": "Error del servidor",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string",
                      "example": "error"
                    },
                    "message": {
                      "type": "string",
                      "example": "Error al crear la orden de envío"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/envios/validar-direccion": {
      "post": {
        "tags": ["envios"],
        "summary": "Validar una dirección",
        "description": "Verifica si una dirección es válida antes de crear una orden de envío",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["calle", "ciudad"],
                "properties": {
                  "calle": {
                    "type": "string",
                    "example": "Calle 123 #45-67"
                  },
                  "ciudad": {
                    "type": "string",
                    "example": "Bogotá"
                  },
                  "departamento": {
                    "type": "string",
                    "example": "Cundinamarca"
                  },
                  "codigo_postal": {
                    "type": "string",
                    "example": "110111"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Resultado de validación de dirección",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string",
                      "example": "success"
                    },
                    "data": {
                      "type": "object",
                      "properties": {
                        "valida": {
                          "type": "boolean",
                          "example": true
                        },
                        "mensaje": {
                          "type": "string",
                          "example": "Dirección validada con éxito"
                        },
                        "sugerencias": {
                          "type": "array",
                          "items": {
                            "type": "string"
                          },
                          "example": []
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Datos inválidos",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string",
                      "example": "error"
                    },
                    "message": {
                      "type": "string",
                      "example": "La calle y la ciudad son requeridas"
                    }
                  }
                }
              }
            }
          },
          "500": {
            "description": "Error del servidor",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string",
                      "example": "error"
                    },
                    "message": {
                      "type": "string",
                      "example": "Error al validar la dirección"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/envios/mis-envios": {
      "get": {
        "tags": ["envios"],
        "summary": "Listar envíos del usuario",
        "description": "Obtiene la lista de envíos creados por el usuario autenticado",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Lista de envíos del usuario",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string",
                      "example": "success"
                    },
                    "data": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "id": {
                            "type": "integer",
                            "example": 1
                          },
                          "estado_actual": {
                            "type": "string",
                            "example": "en_espera"
                          },
                          "fecha_registro": {
                            "type": "string",
                            "format": "date-time",
                            "example": "2023-04-16T10:30:00Z"
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "No autenticado",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string",
                      "example": "error"
                    },
                    "message": {
                      "type": "string",
                      "example": "No se proporcionó un token de autenticación"
                    }
                  }
                }
              }
            }
          },
          "501": {
            "description": "No implementado",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string",
                      "example": "error"
                    },
                    "message": {
                      "type": "string",
                      "example": "Endpoint no implementado todavía"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
